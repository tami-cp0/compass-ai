# Plasmo inlines variables prefixed with PLASMO_PUBLIC_ into the build.
# Copy this to .env and fill it in. The value baked into the build is whatever
# is in .env at build time, so set the right URL before you build:
#   - dev:  ws://localhost:8787/ws
#   - prod: your live wss:// server (e.g. wss://api.yourdomain.com/ws)
# The extension throws on startup if this is missing.

PLASMO_PUBLIC_WS_URL=
