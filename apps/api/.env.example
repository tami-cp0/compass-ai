# All values are required — the API throws on missing env at startup.

# Server
NODE_ENV=
PORT=
# trace | debug | info | warn | error | fatal. Default to "debug" in dev, "info" in prod.
LOG_LEVEL=
# Optional: stable instance identifier for multi-instance deployments. Falls back to hostname.
INSTANCE_ID=
# Optional: comma-separated session IDs to log at debug level even when LOG_LEVEL=info. For targeted prod debugging.
DEBUG_SESSION_IDS=
# Comma-separated list of allowed WS origins. Use chrome-extension://<id> for the extension in prod.
# Ignored when NODE_ENV=development.
ALLOWED_ORIGINS=

GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_RESEARCH_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_DEEP_MODEL=gemini-3.6-flash

# Claude — model id for the web-automation agent. API key is provided per-user
# by the extension (only when web automation is enabled), not set here.
CLAUDE_WEB_MODEL=

# Optional: Neon Postgres connection string for the user-email store. When unset,
# emails are simply not stored (the server runs fine without it).
DATABASE_URL=